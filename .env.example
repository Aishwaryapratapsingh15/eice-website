# Copy this file to .env.local for local development (.env.local is git-ignored).
# For production, the real values live in .env.production (committed).
# For staging, create .env.staging.local and run the app with `dotenv -e .env.staging.local -- next dev`
# (Next.js does not auto-load a .env.staging file, so staging needs to be loaded explicitly).

# CMS backend (blog data). Points at the local cms-backend dev server by default;
# production uses https://eiceapi.eicetechnology.com/api/v1 (see .env.production).
BLOG_API_URL=http://localhost:3000/api/v1

# Rise contact/OTP form endpoints (same across all environments today).
NEXT_PUBLIC_OTP_ENDPOINT=https://rise.eicetechnology.com/otp.php
NEXT_PUBLIC_CHANGE_EMAIL_ENDPOINT=https://rise.eicetechnology.com/changeEmail.php
NEXT_PUBLIC_SUBMIT_ENDPOINT=https://rise.eicetechnology.com/finalsubmission.php
OTP_ENDPOINT=https://rise.eicetechnology.com/otp.php
CHANGE_EMAIL_ENDPOINT=https://rise.eicetechnology.com/changeEmail.php
SUBMIT_ENDPOINT=https://rise.eicetechnology.com/finalsubmission.php
